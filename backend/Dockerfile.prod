# Production image for the FastAPI backend (used by docker-compose.dokploy.yml)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

# Unprivileged user for the server process (see docker-entrypoint.sh)
RUN groupadd --system app && useradd --system --gid app --no-create-home app

COPY --chown=root:root . .
RUN chmod 0755 /app/docker-entrypoint.sh \
    && mkdir -p /app/data && chown app:app /app/data
VOLUME ["/app/data"]

EXPOSE 8000

ENTRYPOINT ["/app/docker-entrypoint.sh"]
# Single worker on purpose: SQLite plus the demo-data seeding at startup
# would race with several workers. --no-server-header hides the uvicorn
# version from responses.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*", "--no-server-header"]
