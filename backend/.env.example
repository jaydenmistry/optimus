# Database
DATABASE_URL=sqlite:///data/inventory.db

# CORS
CORS_ORIGINS=http://localhost:3000

# Security
# "production" makes unset secrets below disable their endpoints instead of leaving them open
ENVIRONMENT=development
# Required for wiping/regenerating demo data (X-Admin-Token header)
ADMIN_TOKEN=
# Required for sensors posting to /api/telemetry (X-API-Key header)
TELEMETRY_API_KEY=
DOCS_ENABLED=true

# Demo Data Configuration
DEMO_NUM_STORES=5
DEMO_NUM_SKUS=200
DEMO_DAYS_HISTORY=60
